# Copy this file to .env and fill in real values. Never commit .env itself.

# Required — Gemini AI for Ask Me / JD Matcher features
GEMINI_API_KEY=

# Optional but recommended — raises GitHub API rate limit from 60/hr to
# 5000/hr and gives accurate follower/repo stats. Create one at
# https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=
